# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dev
MYSQL_USER=user1
MYSQL_PASSWORD=pass

# Shadow Database Configuration
MYSQL_SHADOW_DATABASE=dev_shadow

# Application Configuration
NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_SECRET=your-google-secret

# Database URLs
MYSQL_URL=mysql://user1:pass@db1:3306/dev
MYSQL_URL_SHADOW=mysql://user1:pass@db2:3306/dev_shadow

# Ports
APP_PORT=3000
DB1_PORT=3306
DB2_PORT=3307
PHPMYADMIN_PORT=7070
